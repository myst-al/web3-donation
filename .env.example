# Environment Variables untuk Deployment ke Lisk Sepolia

# Private key dari wallet yang akan digunakan untuk deploy
# PENTING: Jangan pernah commit private key asli ke repository!
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Optional: Etherscan API key untuk verifikasi contract (jika diperlukan)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Contract Address yang sudah di-deploy ke Lisk Sepolia
DONATION_ORGANIZATION_CONTRACT_ADDRESS=your_deployed_contract_address_here

# Network Configuration
NETWORK_NAME=liskSepolia
CHAIN_ID=4202